# Runtime
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:8081

# Supabase (required even when MOCK_AI=true)
# SUPABASE_ANON_KEY accepts Supabase's publishable key (sb_publishable_...)
# SUPABASE_SERVICE_ROLE_KEY accepts the server-only secret key (sb_secret_...)
SUPABASE_URL=
SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# AI provider
# Keep true for the local deterministic AI. Set false only after filling all LLM_* values.
MOCK_AI=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=REPLACE_ME
LLM_MODEL=REPLACE_WITH_A_CHAT_COMPLETIONS_MODEL
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEXT_TIMEOUT_MS=30000
LLM_CLASSIFICATION_TIMEOUT_MS=10000
LLM_EMBEDDING_TIMEOUT_MS=10000

# Optional test-only staging project. Never point destructive integration tests at production.
RUN_SUPABASE_INTEGRATION_TESTS=false
SUPABASE_INTEGRATION_URL=
SUPABASE_INTEGRATION_ANON_KEY=
SUPABASE_INTEGRATION_SERVICE_ROLE_KEY=

# Optional destructive staging verification. Accepted targets deliberately exclude production.
STAGING_TARGET=staging
STAGING_API_URL=
RUN_PROVIDER_SAFETY_EVALS=false
