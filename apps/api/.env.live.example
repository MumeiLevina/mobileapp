# Separate from the private API .env. Only the public Nest entrypoint reads this.
MORI_LIVE_MODE=MOCK
MORI_LIVE_API_PORT=4319
# Generate a new random token; never reuse a Supabase JWT or provider key.
MORI_LIVE_API_TOKEN=
MORI_LIVE_PRINCIPAL=desktop-1
MORI_LIVE_STORE_DIR=.mori-live/public-api
MORI_LIVE_PERSONA=mori-public-vi-v1
MORI_LIVE_SESSION_MINUTES=240
MORI_LIVE_MAX_TURNS=100
MORI_LIVE_REQUESTS_PER_MINUTE=90
MORI_LIVE_TURN_TIMEOUT_MS=45000
# Cumulative reservation ceiling for this repository (USD).
MORI_LIVE_BUDGET_USD=1
# Required in STAGING/REAL. Enter YOUR provider/model prices, never sample guesses.
MORI_LIVE_INPUT_USD_PER_MILLION=
MORI_LIVE_OUTPUT_USD_PER_MILLION=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
