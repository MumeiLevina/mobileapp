# Local demo: no API or Supabase credentials are required.
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_API_URL=http://localhost:3001

# Connected mode: set EXPO_PUBLIC_DEMO_MODE=false and fill these values.
# Android emulator normally uses http://10.0.2.2:3001 for the API.
# A physical device must use your computer's reachable LAN IP or a deployed HTTPS URL.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# Never put a Supabase secret/service-role key or an LLM key in this file.
