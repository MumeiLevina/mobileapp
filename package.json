{
  "name": "mori",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "node scripts/expo.mjs start",
    "dev:web": "node scripts/expo.mjs start --web",
    "export:web": "node scripts/expo.mjs export --platform web",
    "export:native": "node scripts/expo.mjs export --platform android --platform ios",
    "format": "prettier --write apps packages tests e2e scripts *.json *.cjs *.mjs",
    "dev:api": "npm run build -w @mori/shared && npm run dev -w @mori/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages",
    "test": "jest --runInBand",
    "build:api": "npm run build -w @mori/shared && npm run build -w @mori/api",
    "test:mobile": "npm exec -w @mori/mobile -- jest --config jest.config.cjs --runInBand",
    "test:e2e": "npm run export:web && playwright test",
    "test:database": "node scripts/test-database.mjs",
    "test:supabase": "jest --runInBand tests/supabase.integration.test.ts",
    "eval:safety": "jest --runInBand tests/evals/safety.eval.test.ts",
    "preview:web": "node scripts/serve-web.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.0"
  }
}
